# Public site URL used for Paystack's post-payment callback
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Paystack server-side secret. Never expose this in NEXT_PUBLIC variables.
PAYSTACK_SECRET_KEY=sk_live_replace_me

# Optional Google Sheets Apps Script Web App URL for saving checkout leads
GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/replace-me/exec

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_PHONE_NUMBER_ID=replace_me
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=vigency_payment_success
WHATSAPP_TEMPLATE_LANGUAGE=en

# Recommended for production webhook deduplication
UPSTASH_REDIS_REST_URL=https://replace-me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_me
